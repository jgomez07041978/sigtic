<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/thymeleaf-extras-springsecurity5">
<head>
    <meta charset="UTF-8">
    <th:block th:replace="layout/mainLayout :: title" />

    <th:block th:replace="layout/mainLayout :: link" />
</head>
<body>
<div th:replace="layout/mainLayout :: header"></div>

<div th:replace="layout/mainLayout :: sidebar"></div>

<main id="main" class="main">
    <div class="pagetitle">
        <h1 th:text="${titlePage}"></h1>
        <img src="" id="imgPrueba">
        <input type="hidden" id="generaToken" name="generaToken" th:value="${generaToken}">
        <input type="hidden" id="usuarioToken" name="usuarioToken" th:value="${usuarioToken}">
        <input type="hidden" id="secretToken" name="secretToken" th:value="${secretToken}">
        <input type="hidden" id="enviaCorreo" name="enviaCorreo" th:value="${enviaCorreo}">
        <input type="hidden" id="generaQr" name="generaQr" th:value="${generaQr}">
        <input type="hidden" name="idEntePublicoSession" id="idEntePublicoSession" th:value="${idEntePublicoSession}">
        <input type="hidden" name="isAdministradorSigtic" id="isAdministradorSigtic" th:value="${isAdministradorSigtic}">
        <input type="hidden" name="isRolEnlaceCartaResponsiva" id="isRolEnlaceCartaResponsiva" th:value="${isRolEnlaceCartaResponsiva}">
        <input type="hidden" name="isControlFirma" id="isControlFirma" th:value="${isControlFirma}">
        <input type="hidden" name="isAdministradorCr" id="isAdministradorCr" th:value="${isAdministradorCr}">


        <section class="section">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12 col-xxl-12 col-lg-12">

                    <div class="card py-2">
                        <div class="card-body">
                            <form id="idFormGenerar" method="post">
                                <div class="d-grid gap-2">
                                    <div class="row">
                                        <div class="col-sm-12 col-md-12 col-xl-12 col-xxl-12">
                                            <div class="form-floating py-3" th:if="${activeConsultar}">
                                                <select class="form-select form-select-lg" id="idEntePublicoSearch" name="idEntePublicoSearch">
                                                </select>
                                                <label for="idEntePublicoSearch">Ente Público</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" th:if="${isAdministradorCr}">
                                        <div class="col-sm-12 col-md-12 col-xl-5 col-xxl-5">
                                            <div class="form-floating py-3">
                                                <select class="form-select form-select-lg" id="idTipoServicioTic" name="idTipoServicioTic" aria-label="">
                                                </select>
                                                <label for="idTipoServicioTic"><span class="text-danger fw-bold">*</span> Tipo de Servicio</label>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-12 col-xl-4 col-xxl-4">
                                            <div class="form-floating py-3">
                                                <select class="form-select form-select-lg" id="idSubtipoServicioTic" name="idSubtipoServicioTic" aria-label="">
                                                    <option value="">Seleccione</option>
                                                </select>
                                                <label for="idSubtipoServicioTic"><span class="text-danger fw-bold">*</span> Subtipo de Servicio</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="alert alert-success" role="alert" id="idAlertReport" style="display: none">
                                        <span id="idMessageReport"></span>
                                    </div>

                                    <div class="form-floating" th:if="${isAdministradorCr}">
                                        <textarea class="form-control" placeholder="Forma de entrega del servicio" id="notificacionEntrega"  name="notificacionEntrega" style="height: 100px"></textarea>
                                        <label for="notificacionEntrega">Forma de entrega del servicio</label>
                                    </div>
                                    <div class="form-floating" th:if="${isAdministradorCr}">
                                        <button class="btn btn-primary btn-lg" type="submit"><i class="fas fa-cog"></i> Generar</button>
                                    </div>

                                        <!--<button class="btn btn-warning btn-lg"  th:if="${isControlFirma}" type="button" onclick='configurarNumFirma()'><i class="fas fa-cogs"></i> Firma</button>-->

                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="card py-2">
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6 mt-2"><br>
                            <div class="form-check form-check-inline">
                                <input type="checkbox" class="form-check-input" id="estatusVig" name="estatusVig" checked>
                                <label class="form-check-label" for="estatusVig">Vigente</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input type="checkbox" class="form-check-input" id="estatusHis" name="estatusHis">
                                <label class="form-check-label" for="estatusHis">Historico</label>
                            </div>
                        </div>
                    </div>


                    <!--                            <div class="d-flex align-items-center highlight-toolbar border-0 border-bottom mb-2">
                                                    <small class="card-title">Cartas Responsivas</small>
                                                </div>-->
                  <!--  <h5 class="card-title">Cartas Responsivas</span></h5>-->
                    <table id="tableCartaResponsiva" th:if="${activeConsultar}" class="table table-striped table-hover table-sm"  style="width:100%">
                        <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Tipo Servicio</th>
                            <th>SubTipo de Servicio</th>
                            <th>Responsable</th>
                            <th>Fecha Registro</th>
                            <th>Número Servicios</th>
                            <th>Estatus Seguimiento</th>
                            <th>Estatus</th>
                            <th>Acción</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>

        </section>
    </div>


</main>

<th:block th:replace="servicio-tic/cartaResponsivaModal :: modalCartaResponsiva" />
<th:block th:replace="servicio-tic/micartaResponsivaModal :: modalCartaResponsivaAceptada" />
<th:block th:replace="servicio-tic/modalNumFirmas :: modalNumFirmas" />

<th:block th:replace="layout/mainLayout :: footer" />

<th:block th:replace="layout/mainLayout :: script" />

<script type="text/javascript" th:src="@{/js/servicio-tic/carta-responsiva.js}"></script>
</body>
</html>