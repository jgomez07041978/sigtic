    ID_ENTIDADFEDERATIVA_MUNICIPIO    NUMBER(2, 0)     NOT NULL,
    ID_MUNICIPIO                      NUMBER(4, 0)     NOT NULL,
    DESC_MUNICIPIO                    VARCHAR2(50),
    DESC_MUNICIPIO_ABREVIADO          VARCHAR2(50),
    NUM_ORDEN_MUNICIPIO               NUMBER(4, 0),
    ID_COLOR_MUNICIPIO                NUMBER(4, 0),
    ID_IMAGEN_MUNICIPIO               NUMBER(4, 0),
    IP_PC_MTTO                        VARCHAR2(15)     DEFAULT SYS_CONTEXT('USERENV','IP_ADDRESS'),
    NOMBRE_PC_MTTO                    VARCHAR2(255)    DEFAULT SYS_CONTEXT('USERENV','HOST'),
    CVE_USUARIO_SO_MTTO               VARCHAR2(30)     DEFAULT SYS_CONTEXT('USERENV','OS_USER'),
    CVE_USUARIO_MTTO                  VARCHAR2(30)     DEFAULT SYS_CONTEXT('USERENV','CURRENT_SCHEMA'),
    NOMBRE_APLICACION_MTTO            VARCHAR2(30)     DEFAULT SYS_CONTEXT('USERENV','MODULE'),
    FECHA_REGISTRO                    DATE             DEFAULT SYSDATE,
    FECHA_ULTIMO_CAMBIO               DATE             DEFAULT SYSDATE,
    CVE_ESTATUS                       VARCHAR2(3)      DEFAULT 'VIG',
    CONSTRAINT PK_CAT_MUNICIPIOS PRIMARY KEY (ID_ENTIDADFEDERATIVA_MUNICIPIO, ID_MUNICIPIO)
    USING INDEX
        PCTFREE 10
        INITRANS 2
        MAXTRANS 255
        TABLESPACE USERS
        LOGGING
        STORAGE(INITIAL 128K
                NEXT 1024K
                MINEXTENTS 1
                MAXEXTENTS UNLIMITED
                PCTINCREASE 0
                BUFFER_POOL DEFAULT
                )
)
PCTFREE 10
INITRANS 1
MAXTRANS 255
TABLESPACE USERS
LOGGING
NOPARALLEL
STORAGE(INITIAL 448K
        NEXT 64K
        MINEXTENTS 1
        MAXEXTENTS UNLIMITED
        PCTINCREASE 0
        BUFFER_POOL DEFAULT
        )
