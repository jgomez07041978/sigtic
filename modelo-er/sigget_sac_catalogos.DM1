722,"CREATE TABLE SIGGET_SAC_CATALOGOS.CAT_SUBGRUPOS_TIPO_DOCUMENTO(
    ID_GRUPO_TIPO_DOCUMENTO           NUMBER(8, 0)      NOT NULL,
    ID_SUBGRUPO_TIPO_DOCUMENTO        NUMBER(8, 0)      NOT NULL,
    DESC_SUBGRUPO_TIPO_DOCUMENTO      VARCHAR2(100)     NOT NULL,
    DESC_SUBGRUPO_TIPO_DOCUMENTO_A    VARCHAR2(50)      NOT NULL,
    DIRECTORIO_SUBGRUPO_TIPO_DOCTO    VARCHAR2(50)      NOT NULL,
    ALCANCE_SUBGRUPO_TIPODOCUMENTO    VARCHAR2(4000),
    NUM_ORDEN_SUBGRUPO_TIPO_DOCTO     NUMBER(8, 0)      NOT NULL,
    ID_COLOR_SUBGRUPO_TIPO_DOCTO      NUMBER(4, 0),
    ID_IMAGEN_SUBGRUPO_TIPO_DOCTO     NUMBER(4, 0),
    IP_PC_MTTO                        VARCHAR2(15)      DEFAULT SYS_CONTEXT('USERENV','IP_ADDRESS'),
    NOMBRE_PC_MTTO                    VARCHAR2(255)     DEFAULT SYS_CONTEXT('USERENV','HOST'),
    CVE_USUARIO_SO_MTTO               VARCHAR2(30)      DEFAULT SYS_CONTEXT('USERENV','OS_USER'),
    CVE_USUARIO_MTTO                  VARCHAR2(30)      DEFAULT SYS_CONTEXT('USERENV','CURRENT_SCHEMA'),
    NOMBRE_APLICACION_MTTO            VARCHAR2(30)      DEFAULT SYS_CONTEXT('USERENV','MODULE'),
    FECHA_REGISTRO                    DATE              DEFAULT SYSDATE,
    FECHA_ULTIMO_CAMBIO               DATE              DEFAULT SYSDATE,
    CVE_ESTATUS                       VARCHAR2(3)       DEFAULT 'VIG',
    CONSTRAINT PK_CAT_SUBGRUPOS_TIPODOCUMENTO PRIMARY KEY (ID_GRUPO_TIPO_DOCUMENTO, ID_SUBGRUPO_TIPO_DOCUMENTO)
    USING INDEX
        PCTFREE 10
        INITRANS 2
        MAXTRANS 255
        TABLESPACE USERS
        LOGGING
        STORAGE(INITIAL 64K
                NEXT 64K
                MINEXTENTS 1
                MAXEXTENTS UNLIMITED
                PCTINCREASE 0
                BUFFER_POOL DEFAULT
                ), 
    CONSTRAINT FK_CSGTD_GRUPO_TIPO_DOCTO FOREIGN KEY (ID_GRUPO_TIPO_DOCUMENTO)
    REFERENCES SIGGET_SAC_CATALOGOS.CAT_GRUPOS_TIPO_DOCUMENTOS(ID_GRUPO_TIPO_DOCUMENTO)
)
