LOGGING
NOPARALLEL
STORAGE(INITIAL 64K
        NEXT 64K
        MINEXTENTS 1
        MAXEXTENTS UNLIMITED
        PCTINCREASE 0
        BUFFER_POOL DEFAULT
        )
NOCACHE
