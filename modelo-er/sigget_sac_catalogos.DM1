721,"CREATE TABLE SIGGET_SAC_CATALOGOS.CAT_SISTEMAS(
    ID_SISTEMA                 NUMBER(6, 0)     NOT NULL,
    DESC_SISTEMA               VARCHAR2(100),
    DESC_SISTEMA_ABREVIADO     VARCHAR2(50),
    DESC_SISTEMA_ABREVIADO2    VARCHAR2(30),
    NUM_ORDEN_SISTEMA          NUMBER(1, 0),
    ID_COLOR_SISTEMA           NUMBER(4, 0),
    ID_IMAGEN_SISTEMA          NUMBER(4, 0),
    IP_PC_MTTO                 VARCHAR2(15)     DEFAULT SYS_CONTEXT('USERENV','IP_ADDRESS'),
    NOMBRE_PC_MTTO             VARCHAR2(255)    DEFAULT SYS_CONTEXT('USERENV','HOST'),
    CVE_USUARIO_SO_MTTO        VARCHAR2(30)     DEFAULT SYS_CONTEXT('USERENV','OS_USER'),
    CVE_USUARIO_MTTO           VARCHAR2(30)     DEFAULT SYS_CONTEXT('USERENV','CURRENT_SCHEMA'),
    NOMBRE_APLICACION_MTTO     VARCHAR2(30)     DEFAULT SYS_CONTEXT('USERENV','MODULE'),
    FECHA_REGISTRO             DATE             DEFAULT SYSDATE,
    FECHA_ULTIMO_CAMBIO        DATE             DEFAULT SYSDATE,
    CVE_ESTATUS                VARCHAR2(3)      DEFAULT 'VIG',
    CONSTRAINT PK_CAT_SISTEMAS PRIMARY KEY (ID_SISTEMA)
    USING INDEX
        PCTFREE 10
        INITRANS 2
        MAXTRANS 255
        TABLESPACE USERS
        LOGGING
        STORAGE(INITIAL 64K
                NEXT 1024K
                MINEXTENTS 1
                MAXEXTENTS UNLIMITED
                PCTINCREASE 0
                BUFFER_POOL DEFAULT
                )
)
PCTFREE 10
INITRANS 1
MAXTRANS 255
TABLESPACE USERS
LOGGING
NOPARALLEL
STORAGE(INITIAL 64K
        NEXT 64K
        MINEXTENTS 1
        MAXEXTENTS UNLIMITED
        PCTINCREASE 0
        BUFFER_POOL DEFAULT
        )
NOCACHE
NOCOMPRESS
;
